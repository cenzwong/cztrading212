      }
    },
    "type": "object"
  },
  "PositionWalletImpact": {
    "properties": {
      "currency": {
        "description": "The currency code used to represent all the wallet impact information.",
        "type": "string"
      },
      "currentValue": {
        "description": "The current market value of the position.",
        "type": "number"
      },
      "fxImpact": {
        "description": "The positive or negative impact on the position's value due to currency rate changes. Only applies to positions with instrument currency that differs from the accounts.",
