          "number",
          "null"
        ]
      },
      "totalCost": {
        "description": "The total cost paid for the position.",
        "type": "number"
      },
      "unrealizedProfitLoss": {
        "description": "The unrealized profit & loss for the position. Calculated as currentValue - totalCost.",
        "type": "number"
      }
    },
    "type": "object"
